{
  "name": "7-8-card-game-dev-tests",
  "private": true,
  "description": "Dev-only gameplay trace harness. Not needed to play the game.",
  "scripts": {
    "trace": "node run-trace.js",
    "trace:baseline": "node run-trace.js --write baseline",
    "trace:compare": "node run-trace.js --compare baseline",
    "test:e2e": "node tutorial-e2e.js",
    "test:settings": "node settings-e2e.js",
    "test:layout": "node layout-e2e.js",
    "test:smoke": "node browser-smoke.js",
    "test:full": "node browser-smoke.js --full",
    "test:target": "node match-target.js",
    "test:ai:rules": "node sim/ai-rules.js",
    "test:ai": "node sim/ai-match.js"
  },
  "devDependencies": {
    "jsdom": "22.1.0",
    "puppeteer-core": "22.15.0"
  }
}
